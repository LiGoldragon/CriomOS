diff --git a/drivers/media/usb/uvc/uvc_video.c b/drivers/media/usb/uvc/uvc_video.c
--- a/drivers/media/usb/uvc/uvc_video.c
+++ b/drivers/media/usb/uvc/uvc_video.c
@@ -423,6 +423,44 @@
 	return ret;
 }
 
+static bool
+uvc_video_ctrl_is_allowed(const struct uvc_streaming *stream,
+			  const struct uvc_streaming_control *ctrl)
+{
+	unsigned int i;
+
+	for (i = 0; i < stream->nformats; ++i) {
+		const struct uvc_format *format = &stream->formats[i];
+		unsigned int j;
+
+		if (format->index != ctrl->bFormatIndex)
+			continue;
+
+		for (j = 0; j < format->nframes; ++j)
+			if (format->frames[j].bFrameIndex == ctrl->bFrameIndex)
+				return true;
+	}
+
+	return false;
+}
+
+static int
+uvc_video_ctrl_validate(const struct uvc_streaming *stream,
+			const struct uvc_streaming_control *ctrl,
+			const char *operation)
+{
+	if (!(stream->dev->quirks &
+	      UVC_QUIRK_RESTRICT_FRAME_ASPECT_16_9) ||
+	    uvc_video_ctrl_is_allowed(stream, ctrl))
+		return 0;
+
+	dev_err(&stream->intf->dev,
+		"Device returned filtered UVC format %u frame %u for %s\n",
+		ctrl->bFormatIndex, ctrl->bFrameIndex, operation);
+
+	return -EPROTO;
+}
