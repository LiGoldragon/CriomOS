+static bool uvc_frame_is_allowed(const struct uvc_device *dev,
+				 const struct uvc_frame *frame)
+{
+	if (!(dev->quirks & UVC_QUIRK_RESTRICT_FRAME_ASPECT_16_9))
+		return true;
+
